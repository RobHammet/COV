{
  "areas": {
    "exit_to_entryway": {
      "move_into": [{
        "action": "exit",
        "destination": "entryway",
        "arrive_dir": "down",
        "arrive_area": "exit_to_theporch",
        "arrive_sequence": [
          { "action": "narrate",       "text": "HE CAREFULLY WALKED INTO THE HOUSE...", "strict": true },
          { "action": "move",          "actor": "ego", "to": [200, 465], "strict": true },
          { "action": "change_facing", "actor": "ego", "direction": "left" },
          { "action": "narrate",       "text": "LOOKING IN EVERY DIRECTION...", "strict": true },
          { "action": "move",          "actor": "ego", "to": [600, 600], "strict": true }
        ]
      }]
    },
    "exit_to_housefront": { "move_into": [{ "action": "exit", "destination": "housefront", "arrive_dir": "down", "arrive_area": "exit_to_theporch" }] }
  },
  "things": {
    "door": {
      "use": [
        {
          "action": "branch_on_flag",
          "name": "porchDoorOpen",
          "is": false,
          "then": [
            { "action": "move",          "actor": "ego", "target": "door", "strict": true },
            { "action": "change_facing", "actor": "ego", "direction": "up" },
            { "action": "speak",         "actor": "ego", "text": "MAYBE NO ONE WOULD MIND IF \n I JUST GO IN...", "strict": true },
            { "action": "play_animation","actor": "door", "animation": "open" },
            { "action": "set_flag",      "name": "porchDoorOpen", "value": "true" },
            { "action": "remap_floor",   "polygon": "openDoorFloor" }
          ],
          "else": [
            { "action": "speak", "actor": "ego", "text": "IT'S ALREADY OPEN.", "strict": true }
          ]
        }
      ]
    }
  },
  "default": {}
}
