border_style: wavy

thing table:
  on look:
    ego says "IT LOOKS LIKE AN OLD WORKBENCH."

  on use:
    ego -> table strict
    wait 1.5
    ego thinks "I DON'T KNOW MY WAY AROUND A WORK TABLE..."
    wait 0.8
    ego faces right
    ego says "FORGET IT."
    wait 0.8
    narrate "THE HOUSE WAS VERY QUIET."

area exit_to_sittingroom:
  on move_into:
    exit to sittingroom
      arrive_dir right
      arrive_area exit_to_basement
