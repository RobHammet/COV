{
  "areas": {
    "exit_shape": {
      "walk|use": [{
        "action": "exit",
        "destination": "sittingroom",
        "arrive_dir": "down",
        "arrive_thing": "drawers"
      }]
    }
  },
  "things": {
    "drawer": {
      "look": [
        {       "action": "speak", "actor": "ego_point", "text": "IT'S A DRAWER." }       ],
      "use": [
        {
          "action": "if_flag",
          "name": "drawerOpen",
          "is": false,
          "then": [
            { "action": "wait",    "seconds": 1.4 },
            { "action": "toggle_hide", "target": "drawer", "value": false },
            { "action": "wait",    "seconds": 0.6 },
            { "action": "speak", "actor": "ego_point", "text": "WELL [b]LOOKEE[/b] HERE...", "strict": true },
            { "action": "set_flag","name": "drawerOpen", "value": "true" }
          ],
          "else": [
            { "action": "toggle_hide", "target": "drawer", "value": true },
            { "action": "set_flag","name": "drawerOpen", "value": "false" }
          ]
        }
      ]
    }
  },
  "default": {}
}
